# Optional. openFDA works without a key at lower rate limits.
OPENFDA_API_KEY=

# Required only for authenticated OncoKB API access.
ONCOKB_API_TOKEN=

# Optional local licensed exports. The pipeline never bypasses login/paywalls.
NCCN_EXPORT_DIR=manual_imports/nccn
EVIQ_EXPORT_DIR=manual_imports/eviq
MICROMEDEX_EXPORT_DIR=manual_imports/micromedex
LEXIDRUG_EXPORT_DIR=manual_imports/lexidrug
